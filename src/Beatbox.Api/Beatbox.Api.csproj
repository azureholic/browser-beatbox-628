<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <SpaRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\web'))</SpaRoot>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="SeedData\demo-pattern.json" CopyToOutputDirectory="PreserveNewest" />
    <SpaInputs Include="$(SpaRoot)\package.json;$(SpaRoot)\package-lock.json;$(SpaRoot)\tsconfig.json;$(SpaRoot)\vite.config.ts;$(SpaRoot)\index.html;$(SpaRoot)\public\**\*;$(SpaRoot)\src\**\*" />
  </ItemGroup>
  <Target Name="BuildWebFrontend" BeforeTargets="Build" Inputs="@(SpaInputs)" Outputs="$(MSBuildProjectDirectory)\wwwroot\index.html" Condition="'$(DesignTimeBuild)' != 'true' AND '$(SkipSpaBuild)' != 'true'">
    <PropertyGroup>
      <SpaDepsReady Condition="Exists('$(SpaRoot)\node_modules\typescript\bin\tsc') AND Exists('$(SpaRoot)\node_modules\vite\bin\vite.js') AND Exists('$(SpaRoot)\node_modules\@vitejs\plugin-react\package.json') AND Exists('$(SpaRoot)\node_modules\@types\react\package.json') AND Exists('$(SpaRoot)\node_modules\@types\react-dom\package.json') AND Exists('$(SpaRoot)\node_modules\react\package.json') AND Exists('$(SpaRoot)\node_modules\react-dom\package.json')">true</SpaDepsReady>
    </PropertyGroup>
    <Exec WorkingDirectory="$(SpaRoot)" Command="node ./tools/npm-install.mjs --ci" StandardErrorImportance="High" Condition="'$(SpaDepsReady)' != 'true'" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" StandardErrorImportance="High" />
    <ItemGroup><SpaDistFiles Include="$(SpaRoot)\dist\**\*" /></ItemGroup>
    <RemoveDir Directories="$(MSBuildProjectDirectory)\wwwroot" />
    <Copy SourceFiles="@(SpaDistFiles)" DestinationFiles="@(SpaDistFiles->'$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
