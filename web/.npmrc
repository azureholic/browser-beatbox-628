# Bound network retry and timeout intervals so unreachable registries fail
# promptly and allow fallback to https://registry.npmjs.org/ when using
# `npm run install:deps` or `npm run install:ci`.
# Intentionally omits `registry=` so user .npmrc, NPM_CONFIG_REGISTRY, and CI
# environment variables are respected by default.
fetch-retries=2
fetch-retry-factor=2
fetch-retry-mintimeout=2000
fetch-retry-maxtimeout=10000
fetch-timeout=30000
