{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/vite/bin/vite.js build",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "clean": "node ./tools/npm-install.mjs --clean-only",
    "install:deps": "node ./tools/npm-install.mjs",
    "install:ci": "node ./tools/npm-install.mjs --ci",
    "test": "node --test tests/sequencer.test.ts tests/audioEngine.test.ts tests/transportTempo.test.ts tests/stepFeedback.test.ts tests/npmInstall.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
